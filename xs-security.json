{
  "xsappname": "cap-agent-ui5-webui-sample",
  "tenant-mode": "dedicated",
  "description": "Security profile for the cap-agent-ui5-webui sample",

  "oauth2-configuration": {
    "redirect-uris": [
      "https://*.cfapps.eu20-001.hana.ondemand.com/**",
      "http://localhost:5000/**"
    ]
  },

  "scopes": [
    {
      "name": "$XSAPPNAME.support",
      "description": "Use the support agent"
    }
  ],
  "role-templates": [
    {
      "name": "SupportUser",
      "description": "Can chat with the support agent",
      "scope-references": ["$XSAPPNAME.support"]
    }
  ],
  "role-collections": [
    {
      "name": "CapAgentSampleSupportUser",
      "description": "cap-agent-ui5-webui sample - support user",
      "role-template-references": ["$XSAPPNAME.SupportUser"]
    }
  ]
}
