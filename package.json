{
  "name": "cap-agent-ui5-webui-sample",
  "version": "1.0.0",
  "private": true,
  "description": "Sample CAP app using the cap-agent-ui5-webui plugin - local, hybrid and deployed",
  "license": "Apache-2.0",
  "dependencies": {
    "@cap-js/agents": "0.9.1",
    "@cap-js/hana": "^2",
    "@sap/cds": "^10",
    "@sap/xssec": "^4",
    "cap-agent-ui5-webui": "^0.1.0",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@langchain/core": "^1",
    "@playwright/test": "^1.62.1"
  },
  "scripts": {
    "start": "cds-serve",
    "dev": "cds-serve --in-memory",
    "dev:scripted": "node scripts/dev-scripted.mjs",
    "test": "playwright test chat",
    "test:deployed": "playwright test deployed",
    "hybrid": "cds watch --profile hybrid",
    "build": "mbt build",
    "deploy": "cf deploy mta_archives/cap-agent-ui5-webui-sample_1.0.0.mtar"
  },
  "cds": {
    "requires": {
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "auth": {
          "kind": "mocked"
        }
      },
      "[hybrid]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "auth": {
          "kind": "mocked"
        }
      },
      "[production]": {
        "db": {
          "kind": "hana",
          "impl": "@cap-js/hana"
        },
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  }
}
